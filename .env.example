# abide → kev wiring. Copy to .env (gitignored) in the repo you run the agent from.
#
# abide's TypeSafe-compatible client posts each per-edit rule question to
# `${TYPESAFE_AI_BASE_URL}/systemone`. Point it at your local kev server, which
# re-implements that exact API. Note the trailing `/v1` — the SDK appends `/systemone`.
TYPESAFE_AI_BASE_URL=http://127.0.0.1:8009/v1

# kev serves open by default (no auth), so any non-empty value works locally.
# It only has to match if you start kev with KEV_API_KEY set.
TYPESAFE_AI_API_KEY=local
