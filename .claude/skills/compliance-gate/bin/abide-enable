#!/bin/sh
# Turn on abide's per-edit rule checks in one project, against the shared spine rubric and the local kev server.
#
#   abide-enable <project-dir>               link the rubric, add abide's checking hooks, point abide at kev
#   abide-enable --uninstall <project-dir>   remove the hooks and the rubric link
#
# abide reads the rubric from the root of the checkout that holds the edited file, so a git worktree with no
# .abide/rubric.json link gets no checks at all. Enabling a checkout therefore also installs a post-checkout git
# hook (shared by every worktree of the repository) that re-runs this script on each `git worktree add`.
#
# Why not `abide init`: init also installs a SessionStart hook that asks the agent to recompile the rubric whenever
# the project's CLAUDE.md / AGENTS.md are not listed in it with matching hashes. Our rubric is hand-written and shared
# by every project, so that recompile would overwrite it. This installs only the three checking hooks (turn start,
# after each edit, end of turn), plus the abide-serena shim so edits made through serena are checked too, in the
# project's personal .claude/settings.local.json, and keeps both that file and
# the rubric link out of the project's git status via .git/info/exclude.
set -eu

UNINSTALL=0
if [ "${1:-}" = "--uninstall" ]; then UNINSTALL=1; shift; fi
PROJECT=$(cd -- "${1:?usage: abide-enable [--uninstall] <project-dir>}" && pwd -P)
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
SPINE_ROOT=$(cd -- "$SCRIPT_DIR/../../../.." && pwd -P)

command -v jq >/dev/null 2>&1 || { echo "abide-enable: needs jq" >&2; exit 1; }
command -v abide >/dev/null 2>&1 || { echo "abide-enable: install abide first: npm install -g @coldtea/abide" >&2; exit 1; }
HOOK="$(npm root -g)/@coldtea/abide/dist/abide-hook.js"
[ -f "$HOOK" ] || { echo "abide-enable: abide's hook script is not at $HOOK" >&2; exit 1; }

SETTINGS="$PROJECT/.claude/settings.local.json"
mkdir -p "$PROJECT/.claude"
[ -s "$SETTINGS" ] || echo '{}' > "$SETTINGS"

# Every abide entry out (its own hooks and the serena shim), whichever event it sits under; other hooks stay.
STRIP='if .hooks then .hooks |= (with_entries(.value |= (map(.hooks |= map(select((.command // "") | test("abide-hook\\.js|abide-serena") | not))) | map(select(.hooks | length > 0)))) | with_entries(select(.value | length > 0))) else . end
  | if .hooks == {} then del(.hooks) else . end'
# Serena's edit tools go through abide-serena, which replays each change to abide as a Write.
SERENA_EDITS="mcp__serena__(replace_content|replace_symbol_body|insert_after_symbol|insert_before_symbol|rename_symbol|safe_delete_symbol)"
ADD='.hooks.UserPromptSubmit += [{hooks: [{type: "command", command: ($cmd + " turn-start"), timeout: 10}]}]
  | .hooks.PostToolUse += [{matcher: "Edit|Write|MultiEdit|apply_patch", hooks: [{type: "command", command: ($cmd + " post-tool-use"), timeout: 20}]}]
  | .hooks.PreToolUse += [{matcher: $serena, hooks: [{type: "command", command: ($shim + " pre " + $hook), timeout: 10}]}]
  | .hooks.PostToolUse += [{matcher: $serena, hooks: [{type: "command", command: ($shim + " post " + $hook), timeout: 60}]}]
  | .hooks.Stop += [{hooks: [{type: "command", command: ($cmd + " stop"), timeout: 30}]}]'

TMP="$SETTINGS.tmp"
IS_GIT=0
git -C "$PROJECT" rev-parse --git-dir >/dev/null 2>&1 && IS_GIT=1
WORKTREE_HOOK_MARKER="# Installed by compliance-gate/bin/abide-enable."
WORKTREE_HOOK=""
[ "$IS_GIT" = 1 ] && WORKTREE_HOOK="$(git -C "$PROJECT" rev-parse --path-format=absolute --git-path hooks)/post-checkout"

if [ "$UNINSTALL" = 1 ]; then
  jq "$STRIP" "$SETTINGS" > "$TMP" && mv "$TMP" "$SETTINGS"
  if [ -n "$WORKTREE_HOOK" ] && grep -q "$WORKTREE_HOOK_MARKER" "$WORKTREE_HOOK" 2>/dev/null; then rm "$WORKTREE_HOOK"; fi
  [ -L "$PROJECT/.abide/rubric.json" ] && rm "$PROJECT/.abide/rubric.json"
  [ -L "$PROJECT/.abide/events.jsonl" ] && rm "$PROJECT/.abide/events.jsonl"
  echo "abide-enable: removed abide hooks and the rubric link from $PROJECT"
  exit 0
fi
jq --arg cmd "node \"$HOOK\"" --arg hook "\"$HOOK\"" --arg shim "node \"$SCRIPT_DIR/abide-serena\"" \
  --arg serena "$SERENA_EDITS" "$STRIP | $ADD" "$SETTINGS" > "$TMP" && mv "$TMP" "$SETTINGS"

# The shared rubric (/projects-update makes the same link; an existing file or link is left alone).
mkdir -p "$PROJECT/.abide"
[ -e "$PROJECT/.abide/rubric.json" ] || ln -s "$SPINE_ROOT/.abide/rubric.json" "$PROJECT/.abide/rubric.json"

# A worktree logs its checks into the main checkout's events.jsonl, so `abide report` there counts the checks made
# in every worktree, and removing a worktree does not take its share of the stats with it.
if [ "$IS_GIT" = 1 ]; then
  MAIN=$(cd -- "$(dirname -- "$(git -C "$PROJECT" rev-parse --path-format=absolute --git-common-dir)")" && pwd -P)
  if [ "$MAIN" != "$PROJECT" ] && [ ! -e "$PROJECT/.abide/events.jsonl" ] && [ ! -L "$PROJECT/.abide/events.jsonl" ]; then
    mkdir -p "$MAIN/.abide"
    touch "$MAIN/.abide/events.jsonl"
    ln -s "$MAIN/.abide/events.jsonl" "$PROJECT/.abide/events.jsonl"
  fi
fi

# Keep both out of the project's git status, locally only.
# info/exclude is read from the common git dir only, so a worktree must write there, not to its own git dir.
if [ "$IS_GIT" = 1 ]; then
  EXCLUDE="$(git -C "$PROJECT" rev-parse --path-format=absolute --git-path info/exclude)"
  mkdir -p "$(dirname "$EXCLUDE")"
  for p in .abide/ .claude/settings.local.json; do
    git -C "$PROJECT" check-ignore -q "$p" 2>/dev/null || echo "$p" >> "$EXCLUDE"
  done
fi

# Every new worktree of this repository gets the same setup.
if [ -n "$WORKTREE_HOOK" ]; then
  if [ -e "$WORKTREE_HOOK" ] && ! grep -q "$WORKTREE_HOOK_MARKER" "$WORKTREE_HOOK"; then
    echo "abide-enable: $WORKTREE_HOOK exists and is not ours; new worktrees will need abide-enable by hand" >&2
  else
    mkdir -p "$(dirname "$WORKTREE_HOOK")"
    cat > "$WORKTREE_HOOK" <<HOOK
#!/bin/sh
$WORKTREE_HOOK_MARKER
# A new worktree checks out from the null revision; give it abide's rubric link and checking hooks.
[ "\$1" = "0000000000000000000000000000000000000000" ] || exit 0
"$SCRIPT_DIR/abide-enable" "\$(git rev-parse --show-toplevel)" >/dev/null 2>&1 || true
exit 0
HOOK
    chmod +x "$WORKTREE_HOOK"
  fi
fi

# Machine-wide: point abide at the local kev server (abide reads ~/.abide/.env from any repo).
ENV_FILE="${ABIDE_HOME_DIR:-$HOME/.abide}/.env"
mkdir -p "$(dirname "$ENV_FILE")"
grep -q '^TYPESAFE_AI_BASE_URL=' "$ENV_FILE" 2>/dev/null || echo "TYPESAFE_AI_BASE_URL=http://127.0.0.1:${KEV_PORT:-8009}/v1" >> "$ENV_FILE"
grep -q '^TYPESAFE_AI_API_KEY=' "$ENV_FILE" 2>/dev/null || echo "TYPESAFE_AI_API_KEY=local" >> "$ENV_FILE"
chmod 600 "$ENV_FILE"

echo "abide-enable: $PROJECT checks every edit against $(jq '.rules | length' "$SPINE_ROOT/.abide/rubric.json") rules; start kev-serve, then a new agent session"
